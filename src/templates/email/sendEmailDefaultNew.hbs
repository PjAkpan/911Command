<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to 911Command!</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f5f5f5;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    }
    table {
      border-spacing: 0;
      width: 100%;
      border-collapse: collapse;
    }
    td {
      padding: 0;
      vertical-align: top;
    }
    .email-wrapper {
      width: 100%;
      padding: 40px 20px;
      background-color: #f5f5f5;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }
    
    /* Header Section */
    .email-header {
      background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
      padding: 40px 30px;
      text-align: center;
      position: relative;
    }
    .logo-container {
      margin-bottom: 20px;
    }
    .logo {
      height: 32px;
      width: auto;
    }
    .tagline {
      color: #20BFF2;
      font-size: 14px;
      margin: 8px 0 0 0;
      font-weight: 400;
    }
    
    /* Main Content */
    .email-body {
      padding: 40px 30px;
      background-color: #ffffff;
    }
    .welcome-title {
      font-size: 28px;
      font-weight: 700;
      color: #1a1a1a;
      margin: 0 0 24px 0;
      text-align: left;
    }
    .greeting {
      font-size: 16px;
      color: #333333;
      margin: 0 0 20px 0;
      line-height: 1.5;
    }
    .main-text {
      font-size: 15px;
      color: #555555;
      line-height: 1.6;
      margin: 0 0 24px 0;
    }
    
    /* CTA Button */
    .cta-container {
      margin: 32px 0;
      text-align: left;
    }
    .cta-button {
      display: inline-block;
      background-color: #20BFF2;
      color: #ffffff !important;
      text-decoration: none;
      padding: 14px 28px;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      transition: background-color 0.3s ease;
    }
    .cta-button:hover {
      background-color: #1ba5d1;
    }
    
    /* Info Sections */
    .info-section {
      margin: 32px 0;
    }
    .section-title {
      font-size: 18px;
      font-weight: 600;
      color: #1a1a1a;
      margin: 0 0 16px 0;
    }
    .info-list {
      margin: 0;
      padding-left: 20px;
    }
    .info-list li {
      font-size: 15px;
      color: #555555;
      line-height: 1.6;
      margin-bottom: 8px;
    }
    .info-list li strong {
      color: #1a1a1a;
    }
    
    /* Contact Info */
    .contact-info {
      margin: 32px 0;
      font-size: 15px;
      color: #555555;
      line-height: 1.6;
    }
    .contact-info a {
      color: #20BFF2;
      text-decoration: none;
    }
    .contact-info a:hover {
      text-decoration: underline;
    }
    
    /* Social Section */
    .social-section {
      background-color: #fafafa;
      padding: 30px;
      text-align: center;
      border-top: 1px solid #e5e5e5;
    }
    .social-title {
      font-size: 16px;
      font-weight: 600;
      color: #1a1a1a;
      margin: 0 0 16px 0;
    }
    .social-icons {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin-bottom: 24px;
    }
    .social-icon {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: transform 0.2s ease;
    }
    .social-icon:hover {
      transform: translateY(-2px);
    }
    .social-icon.gmail {
      background-color: #ea4335;
      color: white;
    }
    .social-icon.instagram {
      background: linear-gradient(45deg, #405de6, #5851db, #833ab4, #c13584, #e1306c, #fd1d1d);
      color: white;
    }
    .social-icon.linkedin {
      background-color: #0077b5;
      color: white;
    }
    
    /* Footer */
    .email-footer {
      background-color: #1a1a1a;
      color: #cccccc;
      text-align: center;
      padding: 30px;
      font-size: 13px;
      line-height: 1.5;
    }
    .footer-text {
      margin: 0 0 12px 0;
    }
    .footer-links {
      margin-top: 16px;
    }
    .footer-links a {
      color: #20BFF2;
      text-decoration: none;
      margin: 0 8px;
    }
    .footer-links a:hover {
      text-decoration: underline;
    }
    
    /* Mobile Responsiveness */
    @media only screen and (max-width: 600px) {
      .email-wrapper {
        padding: 20px 10px;
      }
      .email-body, .email-header, .social-section, .email-footer {
        padding: 24px 20px;
      }
      .welcome-title {
        font-size: 24px;
      }
      .cta-button {
        display: block;
        text-align: center;
        width: 100%;
        box-sizing: border-box;
      }
      .social-icons {
        flex-wrap: wrap;
      }
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <table class="email-container" role="presentation">
      <!-- Header -->
      <tr>
        <td class="email-header">
          <div class="logo-container">
            <!-- Replace with actual logo URL -->
            <svg class="logo" viewBox="0 0 200 40" fill="none">
              <text x="0" y="25" fill="#20BFF2" font-family="Arial, sans-serif" font-size="24" font-weight="bold">911Command</text>
            </svg>
          </div>
          <p class="tagline">Quick respond</p>
        </td>
      </tr>
      
      <!-- Main Content -->
      <tr>
        <td class="email-body">
           {{content}}
        </td>
      </tr>
      
      <!-- Social Section -->
    <tr>
  <td class="social-section">
    <h3 class="social-title">Find Us On</h3>

    <div class="social-icons">
      <a href="#" class="social-icon gmail" title="Email">
        <img src="https://yourcdn.com/icons/email.png" width="20" height="20" alt="Email"/>
      </a>

      <a href="#" class="social-icon instagram" title="Instagram">
        <img src="https://yourcdn.com/icons/instagram.png" width="20" height="20" alt="Instagram"/>
      </a>

      <a href="#" class="social-icon linkedin" title="LinkedIn">
        <img src="https://yourcdn.com/icons/linkedin.png" width="20" height="20" alt="LinkedIn"/>
      </a>
    </div>

    <p style="font-size: 13px; color: #666; margin: 0;">
      911Command &copy; {{getFullYear}} | Health care made simple<br/>
      800 Steeles Ave W, abuja  • +234(80) 410-1910
    </p>
  </td>
</tr>

      
      <!-- Footer -->
      <tr>
        <td class="email-footer">
          <div class="footer-links">
            <a href="#">Support</a> |
            <a href="#">Unsubscribe</a>
          </div>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>